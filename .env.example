ANTHROPIC_API_KEY=your-api-key-here

# Audio-Transkription beim Datei-Upload (Sprache-zu-Text + Sprechererkennung
# über gpt-4o-transcribe-diarize, Fallback whisper-1 für flac/ogg). Ohne
# diesen Key wird eine hochgeladene Audiodatei zwar gespeichert und
# abspielbar gemacht, aber nicht transkribiert. Key erstellen unter
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Sprachausgabe (TTS) für Chat-Antworten (Backlog #49) über Google Cloud
# Text-to-Speech, Stimme "Chirp3-HD". Ohne diesen Key fällt die Sprachaus-
# gabe automatisch auf die (weniger natürliche) Stimme des Browsers zurück -
# die App bricht dadurch nicht, Sprachausgabe funktioniert also auch ohne
# Key. Key erstellen: Google Cloud Projekt -> "Cloud Text-to-Speech API"
# aktivieren -> API-Key unter "APIs & Dienste" -> "Anmeldedaten" erstellen.
GOOGLE_TTS_API_KEY=
# Override für den Stimmennamen (optional) - überschreibt die in
# app/tts.py fest hinterlegten Stimmen für beide Sprachen gleichzeitig.
GOOGLE_TTS_VOICE_NAME=

# Cloudflare Turnstile (Spam-/Bot-Schutz für die Frage-Eingabe) - ohne diese
# Werte bleibt der Schutz inaktiv (App funktioniert trotzdem, nur ungeschützt).
# TURNSTILE_SITE_KEY ist öffentlich (landet im Frontend über
# GET /api/turnstile-config), TURNSTILE_SECRET_KEY bleibt geheim/serverseitig.
# WICHTIG: ein für die echte Produktionsdomain registrierter Site-Key
# akzeptiert kein localhost - die Challenge bleibt dort für immer "pending",
# ohne sichtbaren Fehler, und /api/ask liefert dauerhaft "Sicherheitsprüfung
# fehlgeschlagen". Für lokale Entwicklung deshalb eines von Cloudflares
# offiziellen, öffentlich dokumentierten Test-Schlüsselpaaren nutzen
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/):
#   Prüfung besteht immer:  TURNSTILE_SITE_KEY=1x00000000000000000000AA
#                           TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   Prüfung schlägt immer fehl (zum Testen des Fehlerpfads):
#                           TURNSTILE_SITE_KEY=2x00000000000000000000AB
#                           TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA
# In Stabil/Produktion stattdessen den echten, für die jeweilige Domain im
# Cloudflare-Dashboard registrierten Site-/Secret-Key eintragen.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Login-System (Magic-Link, invite-only)
# Signiert Session-Cookies und Magic-Link-Tokens (HMAC). Ohne diesen Wert
# nutzt der Prozess einen zufälligen, nur für seine Laufzeit gültigen
# Schlüssel - Logins/Einladungslinks überleben dann keinen Neustart.
SESSION_SECRET_KEY=

# SMTP-Zugangsdaten für den Versand von Login-/Einladungs-Links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# "development": Login-/Einladungs-Links werden NICHT per Mail verschickt,
# sondern in die Server-Konsole geschrieben (auch aktiv, wenn SMTP_HOST leer
# bleibt). Cookies werden dann außerdem ohne "Secure"-Flag gesetzt, damit sie
# auch über http://localhost funktionieren.
ENVIRONMENT=

# Wird beim Start idempotent mit der Rolle system_admin angelegt - Erstzugang
# und Recovery-Mechanismus, kann dauerhaft gesetzt bleiben.
SYSTEM_ADMIN_EMAIL=
